---
# Ansible-lint configuration
profile: production

# Exclude certain paths
exclude_paths:
  - .cache/
  - .git/
  - venv/

# Offline mode. Must stay true: when online, ansible-lint runs its own
# `ansible-galaxy collection install -r requirements.yml`, which finds the
# collections already present and writes an empty stub into
# .ansible/collections/. That stub then shadows the real collection and every
# community.general module reports as syntax-check[unknown-module].
offline: true

# List of rules to skip
skip_list:
  - yaml[line-length]  # Allow longer lines in some cases
  - no-changed-when    # Some commands legitimately need changed_when
  - command-instead-of-module  # Some arch-chroot commands cannot be replaced
  - risky-shell-pipe   # Some shell pipes are necessary

# Warn for these rules instead of failing
warn_list:
  - experimental
  - no-handler
  - fqcn[action-core]

# Enable checking for specific rule violations
enable_list:
  - yaml
  - fqcn-builtins

# Use the default set of rules
use_default_rules: true

# Do NOT add mock_modules here. ansible-lint materialises each entry as a stub
# .py inside the collections path, and ansible.cfg points collections_path at
# ~/.ansible/collections — so mocking a real module overwrites it and every
# subsequent playbook run fails with "Unsupported parameters ... Supported
# parameters include: ." Install the collection instead (mise run install).
mock_modules: []

mock_roles: []

# Write JSON output for easier parsing
# parseable: true
