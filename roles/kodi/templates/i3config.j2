# i3 config - managed by ansible (kodi role)

# Mod key
set $mod Mod4

# Workspace names
set $ws1 "1: kodi"
set $ws2 "2: browser"

# Assign applications to workspaces
assign [class="Kodi"] $ws1
assign [class="zen"] $ws2

# Autostart
exec --no-startup-id kodi
exec --no-startup-id {{ kodi_browser }}

# Start on workspace 1
exec --no-startup-id i3-msg workspace $ws1

# Window rules - Kodi fullscreen on workspace 1
for_window [class="Kodi"] fullscreen enable

# Basic keybindings
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Return exec wezterm
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"
bindsym $mod+Shift+r restart
